# Copy to `.env.production` on the VPS and adjust. Every var flagged
# `:?required` in docker-compose.prod.yml MUST be set or the stack
# refuses to start.
#
# Rotate JWT_SECRET on a breach or a suspicion of one; new tokens use
# the new secret, old tokens invalidate. Sessions ceiling out anyway.

# Host — Traefik uses this to route and to request the LE cert.
APP_HOST=change.example.com

# Postgres
POSTGRES_USER=currency_app
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password
POSTGRES_DB=currency_exchange

# API
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_TTL=12h
COOKIE_NAME=cx_session
BUSINESS_TZ=Africa/Nouakchott

# Seed bootstrap owner. Required in production per api/prisma/seed.ts.
BOOTSTRAP_OWNER_PHONE=+22200000000
BOOTSTRAP_OWNER_PIN=CHANGE_ME
BOOTSTRAP_OWNER_NAME=Owner

// Prisma schema. Models added phase by phase per docs/phases/phase-N.md.
// P1-04 introduces the auth surface (User, Role, Permission, plus the join
// tables and audit_log). No financial tables land until P3-01.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// P1-04 · auth
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid()) @db.Uuid
  phone             String    @unique
  pinHash           String    @map("pin_hash")
  fullName          String    @map("full_name")
  isActive          Boolean   @default(true) @map("is_active")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles     UserRole[]
  auditRows AuditLog[] @relation("audit_actor")

  @@map("user")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  labelFr  String  @map("label_fr")
  labelAr  String  @map("label_ar")

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// P2-01 · currencies (master data)
// ---------------------------------------------------------------------------
//
// `code` is the ISO-4217-ish identifier we display everywhere ("MRU", "USD").
// It is *not* immutable in the schema — the immutability check is enforced
// in the service by counting rows in the ledger (P3+). Making it immutable
// at the DB level would fight the initial seed & typo-correction window.
//
// `decimalPlaces` drives every rounding decision (D-009). USD=2, JPY=0,
// high-precision internal book-keeping currencies can go up to 6.
// `lowBalanceThreshold` is per-currency (spec §22.3 dashboard warning);
// nullable = no warning configured.
//
// No `is_base` column — the base currency is a single FK on the settings
// row (added in P2-02). Duplicating it here would risk two rows disagreeing.
//
// Deletion is refused at the application role level via a REVOKE in the
// migration. See phase-2.md §3.

model Currency {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique
  name                  String
  symbol                String?
  decimalPlaces         Int      @map("decimal_places") @db.SmallInt
  lowBalanceThreshold   Decimal? @map("low_balance_threshold") @db.Decimal(24, 4)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("currency")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  before       Json?
  after        Json?
  reason       String?
  ip           String?  @db.Inet
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("audit_actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_log_entity_created_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_log_actor_created_idx")
  @@map("audit_log")
}

// Prisma schema. Models added phase by phase per docs/phases/phase-N.md.
// P1-04 introduces the auth surface (User, Role, Permission, plus the join
// tables and audit_log). No financial tables land until P3-01.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// P1-04 · auth
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid()) @db.Uuid
  phone            String    @unique
  pinHash          String    @map("pin_hash")
  fullName         String    @map("full_name")
  isActive         Boolean   @default(true) @map("is_active")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles              UserRole[]
  auditRows          AuditLog[]       @relation("audit_actor")
  ledgerEntries      CurrencyLedger[] @relation("ledger_created_by")
  purchases          Purchase[]       @relation("purchase_created_by")
  purchasesReversed  Purchase[]       @relation("purchase_reversed_by")
  sales              Sale[]           @relation("sale_created_by")
  salesReversed      Sale[]           @relation("sale_reversed_by")
  payments           Payment[]        @relation("payment_created_by")
  paymentsReversed   Payment[]        @relation("payment_reversed_by")
  expenses           Expense[]        @relation("expense_created_by")
  expensesReversed   Expense[]        @relation("expense_reversed_by")

  @@map("user")
}

model Role {
  id      String @id @default(uuid()) @db.Uuid
  code    String @unique
  labelFr String @map("label_fr")
  labelAr String @map("label_ar")

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// P2-01 · currencies (master data)
// ---------------------------------------------------------------------------
//
// `code` is the ISO-4217-ish identifier we display everywhere ("MRU", "USD").
// It is *not* immutable in the schema — the immutability check is enforced
// in the service by counting rows in the ledger (P3+). Making it immutable
// at the DB level would fight the initial seed & typo-correction window.
//
// `decimalPlaces` drives every rounding decision (D-009). USD=2, JPY=0,
// high-precision internal book-keeping currencies can go up to 6.
// `lowBalanceThreshold` is per-currency (spec §22.3 dashboard warning);
// nullable = no warning configured.
//
// No `is_base` column — the base currency is a single FK on the settings
// row (added in P2-02). Duplicating it here would risk two rows disagreeing.
//
// Deletion is refused at the application role level via a REVOKE in the
// migration. See phase-2.md §3.

model Currency {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique
  name                String
  symbol              String?
  decimalPlaces       Int      @map("decimal_places") @db.SmallInt
  lowBalanceThreshold Decimal? @map("low_balance_threshold") @db.Decimal(24, 4)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  baseForSettings    Settings[]       @relation("settings_base_currency")
  ledgerEntries      CurrencyLedger[]
  balance            CurrencyBalance?
  costMovements      CostMovement[]
  cost               CurrencyCost?
  openingBalance     OpeningBalance?
  receivables        Receivable[]
  payables           Payable[]
  purchasesDelivered Purchase[]       @relation("purchase_delivered_currency")
  purchasesPayment   Purchase[]       @relation("purchase_payment_currency")
  salesDelivered     Sale[]           @relation("sale_delivered_currency")
  salesPayment       Sale[]           @relation("sale_payment_currency")
  payments           Payment[]
  expenses           Expense[]

  @@map("currency")
}

// ---------------------------------------------------------------------------
// P2-02 · settings (single-row)
// ---------------------------------------------------------------------------
//
// The one row. `id = 1` is enforced by a CHECK in the migration so a
// second row cannot exist. `baseCurrencyId` FKs to Currency; the seed
// pins it to MRU. `businessTimezone` is what common/period.ts reads at
// runtime — the env var stays as a test-boot fallback (D-012).
//
// `goLiveAt` is set exactly once and never cleared (checked in the
// service). Before it is set, opening balances are editable (P3-10);
// after, only owner-authorized adjustments.
//
// `negativeBalanceOverrideAllowed` is the tri-state toggle for D-015 —
// even when true, non-base currencies still refuse a negative balance
// at the DB level (P3 constraint). MRU can be overdrawn only by owners
// with a reason.

model Settings {
  id                             Int       @id @default(1)
  baseCurrencyId                 String    @map("base_currency_id") @db.Uuid
  businessTimezone               String    @default("Africa/Nouakchott") @map("business_timezone")
  negativeBalanceOverrideAllowed Boolean   @default(false) @map("negative_balance_override_allowed")
  goLiveAt                       DateTime? @map("go_live_at") @db.Timestamptz(6)
  updatedAt                      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId                String?   @map("updated_by_user_id") @db.Uuid

  baseCurrency Currency @relation("settings_base_currency", fields: [baseCurrencyId], references: [id], onDelete: Restrict)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// P2-03 · contact (customers + suppliers, one row per person)
// ---------------------------------------------------------------------------
//
// A single row for a person who transacts with the bureau. `isCustomer` and
// `isSupplier` are independent booleans — the same person can be both, and
// the CHECK constraint refuses a row that is neither (spec §10.2, phase-2.md
// §3). Flipping either flag preserves the row's ID and notes.
//
// `phone` is nullable — walk-in customers may not want to give one, and the
// duplicate-phone rule is a **warning, not a block** (spec §10.3). The
// service returns 409 with `warning: duplicate_phone` on POST; a second POST
// with `confirmDuplicate: true` proceeds. Enforcing uniqueness at the DB
// would remove the operator's ability to say "yes it's a different person
// with the same number".
//
// `isArchived` replaces delete. Once a contact appears on a trade or debt
// their row must remain readable for historical statements.

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  phone      String?
  isCustomer Boolean  @default(true) @map("is_customer")
  isSupplier Boolean  @default(false) @map("is_supplier")
  isArchived Boolean  @default(false) @map("is_archived")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  receivables Receivable[]
  payables    Payable[]
  purchases   Purchase[]
  sales       Sale[]
  payments    Payment[]

  @@index([phone], map: "contact_phone_idx")
  @@map("contact")
}

// ---------------------------------------------------------------------------
// P2-04 · expense_category (lookup)
// ---------------------------------------------------------------------------
//
// Categorises expense rows (P5). Kept as an editable table — the client
// tunes the taxonomy over time. Referenced by `expense.category_id` from
// P5-01; deactivation is preferred over delete for the same historical
// reason as currency / payment_method / contact.

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  expenses Expense[]

  @@map("expense_category")
}

// ---------------------------------------------------------------------------
// P2-05 · payment_method lookup (D-020)
// ---------------------------------------------------------------------------
//
// Not an enum — Mauritanian mobile-money providers change. A new one
// should be a row the owner adds in Settings, not a migration + deploy.
// Seeded with CASH / BANKILY / MASRIVI / SEDAD / OTHER; only OTHER has
// requires_note = true. `code` is unique and never edited after create
// — renaming a method would rewrite how last year's cash arrived
// (architecture §3.6).
//
// Referenced by the `payment_method_id` column on ledger entries from
// P3-02 (D-020). The relation itself is added when the ledger table
// exists.

model PaymentMethod {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  labelFr      String   @map("label_fr")
  labelAr      String   @map("label_ar")
  isActive     Boolean  @default(true) @map("is_active")
  requiresNote Boolean  @default(false) @map("requires_note")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledgerEntries CurrencyLedger[]
  purchases     Purchase[]
  sales         Sale[]
  payments      Payment[]
  expenses      Expense[]

  @@map("payment_method")
}

// ---------------------------------------------------------------------------
// P3-01 · ledger core (D-003, D-004, D-020)
// ---------------------------------------------------------------------------
//
// Four tables. All writes to any of them go through LedgerService.apply
// (architecture §3.3). The database independently enforces
// cached_amount >= 0 for non-base currencies via a trigger (§7.2 of the
// schema review), and the application role has no DELETE grant on any
// of these tables (§7.1–7.4). Reversal flips is_active=false; nothing
// is ever removed.
//
// `sequence` on both currency_ledger and cost_movement is filled from a
// dedicated Postgres SEQUENCE (`ledger_sequence_seq`), not from the id
// column. That way a future partitioning of the ledger doesn't break
// CostEngine.replay (D-023 item 1). The SEQUENCE is created by hand in
// the migration file; Prisma's `dbgenerated()` just references it.

enum LedgerDirection {
  CREDIT
  DEBIT

  @@map("ledger_direction")
}

enum CostMovementKind {
  ACQUISITION
  DISPOSAL

  @@map("cost_movement_kind")
}

model CurrencyLedger {
  id              BigInt          @id @default(autoincrement())
  currencyId      String          @map("currency_id") @db.Uuid
  direction       LedgerDirection
  amount          Decimal         @db.Decimal(24, 4)
  sourceType      String          @map("source_type")
  sourceId        String?         @map("source_id") @db.Uuid
  paymentMethodId String?         @map("payment_method_id") @db.Uuid
  note            String?
  transactionDate DateTime        @map("transaction_date") @db.Timestamptz(6)
  sequence        BigInt          @default(dbgenerated("nextval('ledger_sequence_seq'::regclass)"))
  description     String
  isActive        Boolean         @default(true) @map("is_active")
  createdByUserId String          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  currency      Currency       @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("ledger_created_by", fields: [createdByUserId], references: [id], onDelete: Restrict)
  costMovement  CostMovement?

  @@index([currencyId, sequence], map: "currency_ledger_currency_sequence_idx")
  @@index([sourceType, sourceId], map: "currency_ledger_source_idx")
  @@index([transactionDate(sort: Desc)], map: "currency_ledger_transaction_date_idx")
  @@index([createdByUserId, createdAt(sort: Desc)], map: "currency_ledger_creator_created_idx")
  @@map("currency_ledger")
}

model CurrencyBalance {
  currencyId   String   @id @map("currency_id") @db.Uuid
  cachedAmount Decimal  @default(0) @map("cached_amount") @db.Decimal(24, 4)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@map("currency_balance")
}

model CostMovement {
  id             BigInt           @id @default(autoincrement())
  currencyId     String           @map("currency_id") @db.Uuid
  ledgerEntryId  BigInt           @unique @map("ledger_entry_id")
  kind           CostMovementKind
  quantity       Decimal          @db.Decimal(24, 4)
  unitCostMru    Decimal          @map("unit_cost_mru") @db.Decimal(24, 8)
  realizedPnlMru Decimal?         @map("realized_pnl_mru") @db.Decimal(24, 4)
  isActive       Boolean          @default(true) @map("is_active")
  sequence       BigInt
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  currency    Currency       @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  ledgerEntry CurrencyLedger @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([currencyId, sequence], map: "cost_movement_currency_sequence_idx")
  @@map("cost_movement")
}

model CurrencyCost {
  currencyId     String   @id @map("currency_id") @db.Uuid
  cachedAvgMru   Decimal  @default(0) @map("cached_avg_mru") @db.Decimal(24, 8)
  cachedQuantity Decimal  @default(0) @map("cached_quantity") @db.Decimal(24, 4)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@map("currency_cost")
}

// ---------------------------------------------------------------------------
// P3-08 · opening balances (D-003) + P3-09 · opening debts (D-010)
// ---------------------------------------------------------------------------
//
// opening_balance is written exactly once per currency during pre-go-live
// (settings.go_live_at is null). Each row produces exactly one
// currency_ledger CREDIT and one cost_movement ACQUISITION via
// LedgerService.apply — the openings service is the first ledger writer
// in the system.
//
// receivable / payable are the debt tables, shipped as skeletons here
// (schema-review §3.2) because opening debts (P3-09) need somewhere to
// land. Full lifecycle — allocations, payment_status recomputation,
// settlements — arrives in P5. The columns are all present now so P5
// doesn't need another migration.
//
// (source_type, source_id) is polymorphic. D-023 item 3 tracks the
// possibility of splitting into receivable_id/payable_id on allocation
// (a different table) before P5-01; the same trade-off does not apply
// here — no FK fan is worth it for two source types.

enum DebtOrigin {
  TRADE
  OPENING

  @@map("debt_origin")
}

enum DebtStatus {
  OPEN
  CLOSED
  REVERSED

  @@map("debt_status")
}

enum DebtPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID

  @@map("debt_payment_status")
}

model OpeningBalance {
  id                String   @id @default(uuid()) @db.Uuid
  currencyId        String   @unique @map("currency_id") @db.Uuid
  quantity          Decimal  @db.Decimal(24, 4)
  openingAvgCostMru Decimal  @map("opening_avg_cost_mru") @db.Decimal(24, 8)
  effectiveDate     DateTime @map("effective_date") @db.Date
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@map("opening_balance")
}

model Receivable {
  id                String            @id @default(uuid()) @db.Uuid
  contactId         String            @map("contact_id") @db.Uuid
  currencyId        String            @map("currency_id") @db.Uuid
  originalAmount    Decimal           @map("original_amount") @db.Decimal(24, 4)
  outstandingAmount Decimal           @map("outstanding_amount") @db.Decimal(24, 4)
  origin            DebtOrigin
  sourceType        String?           @map("source_type")
  sourceId          String?           @map("source_id") @db.Uuid
  status            DebtStatus        @default(OPEN)
  paymentStatus     DebtPaymentStatus @default(UNPAID) @map("payment_status")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([contactId, currencyId, status], map: "receivable_contact_currency_status_idx")
  @@index([origin, sourceType, sourceId], map: "receivable_origin_source_idx")
  @@map("receivable")
}

model Payable {
  id                String            @id @default(uuid()) @db.Uuid
  contactId         String            @map("contact_id") @db.Uuid
  currencyId        String            @map("currency_id") @db.Uuid
  originalAmount    Decimal           @map("original_amount") @db.Decimal(24, 4)
  outstandingAmount Decimal           @map("outstanding_amount") @db.Decimal(24, 4)
  origin            DebtOrigin
  sourceType        String?           @map("source_type")
  sourceId          String?           @map("source_id") @db.Uuid
  status            DebtStatus        @default(OPEN)
  paymentStatus     DebtPaymentStatus @default(UNPAID) @map("payment_status")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([contactId, currencyId, status], map: "payable_contact_currency_status_idx")
  @@index([origin, sourceType, sourceId], map: "payable_origin_source_idx")
  @@map("payable")
}

// ---------------------------------------------------------------------------
// P4-01 · trades (D-005, D-013, D-019, D-023 item 4, D-024)
// ---------------------------------------------------------------------------
//
// Purchase = bureau receives `delivered_currency`, pays `payment_currency`.
// Sale     = bureau gives  `delivered_currency`, receives `payment_currency`.
//
// Exactly one leg is the base currency (D-019). Enforced by trigger
// `check_trade_has_base_leg` on both tables. The trade services build
// Movement[] arrays with the correct base/non-base direction and hand
// them to LedgerService.apply (architecture §3.3) — no direct writes
// to the ledger/balance/cost tables from here.
//
// `outstanding_amount` mirrors `payment_total − immediate_payment`
// exactly and is immutable in v2. Once the payment lifecycle lands in
// P5, an allocation drops it and flips `payment_status`.
//
// `idempotency_key` + `idempotency_body_hash` live on the trade row
// per schema-review §4.1 (partial unique on `(created_by_user_id,
// idempotency_key)`). No TTL per D-023 item 5.

enum TradeStatus {
  CONFIRMED
  CANCELLED
  REVERSED

  @@map("trade_status")
}

enum TradePaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID

  @@map("trade_payment_status")
}

model Purchase {
  id                  String             @id @default(uuid()) @db.Uuid
  contactId           String?            @map("contact_id") @db.Uuid
  deliveredCurrencyId String             @map("delivered_currency_id") @db.Uuid
  deliveredAmount     Decimal            @map("delivered_amount") @db.Decimal(24, 4)
  paymentCurrencyId   String             @map("payment_currency_id") @db.Uuid
  paymentTotal        Decimal            @map("payment_total") @db.Decimal(24, 4)
  rate                Decimal            @db.Decimal(24, 8)
  immediatePayment    Decimal            @default(0) @map("immediate_payment") @db.Decimal(24, 4)
  outstandingAmount   Decimal            @map("outstanding_amount") @db.Decimal(24, 4)
  status              TradeStatus        @default(CONFIRMED)
  paymentStatus       TradePaymentStatus @map("payment_status")
  paymentMethodId     String?            @map("payment_method_id") @db.Uuid
  paymentMethodNote   String?            @map("payment_method_note")
  reference           String?
  notes               String?
  transactionDate     DateTime           @map("transaction_date") @db.Timestamptz(6)
  idempotencyKey      String?            @map("idempotency_key")
  idempotencyBodyHash String?            @map("idempotency_body_hash")
  createdByUserId     String             @map("created_by_user_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  reversalReason      String?            @map("reversal_reason")
  reversedByUserId    String?            @map("reversed_by_user_id") @db.Uuid
  reversedAt          DateTime?          @map("reversed_at") @db.Timestamptz(6)

  contact           Contact?       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  deliveredCurrency Currency       @relation("purchase_delivered_currency", fields: [deliveredCurrencyId], references: [id], onDelete: Restrict)
  paymentCurrency   Currency       @relation("purchase_payment_currency", fields: [paymentCurrencyId], references: [id], onDelete: Restrict)
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  createdBy         User           @relation("purchase_created_by", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedBy        User?          @relation("purchase_reversed_by", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@index([transactionDate(sort: Desc), status], map: "purchase_transaction_status_idx")
  @@index([contactId, transactionDate(sort: Desc)], map: "purchase_contact_transaction_idx")
  @@map("purchase")
}

model Sale {
  id                    String             @id @default(uuid()) @db.Uuid
  contactId             String?            @map("contact_id") @db.Uuid
  deliveredCurrencyId   String             @map("delivered_currency_id") @db.Uuid
  deliveredAmount       Decimal            @map("delivered_amount") @db.Decimal(24, 4)
  paymentCurrencyId     String             @map("payment_currency_id") @db.Uuid
  paymentTotal          Decimal            @map("payment_total") @db.Decimal(24, 4)
  rate                  Decimal            @db.Decimal(24, 8)
  immediatePayment      Decimal            @default(0) @map("immediate_payment") @db.Decimal(24, 4)
  outstandingAmount     Decimal            @map("outstanding_amount") @db.Decimal(24, 4)
  status                TradeStatus        @default(CONFIRMED)
  paymentStatus         TradePaymentStatus @map("payment_status")
  paymentMethodId       String?            @map("payment_method_id") @db.Uuid
  paymentMethodNote     String?            @map("payment_method_note")
  reference             String?
  notes                 String?
  transactionDate       DateTime           @map("transaction_date") @db.Timestamptz(6)
  idempotencyKey        String?            @map("idempotency_key")
  idempotencyBodyHash   String?            @map("idempotency_body_hash")
  createdByUserId       String             @map("created_by_user_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Snapshot cost + profit at confirmation. NEVER updated (architecture §3.6);
  // reversal recomputes and restates via CostEngine.replay (D-021).
  costOfCurrencySoldMru Decimal            @map("cost_of_currency_sold_mru") @db.Decimal(24, 4)
  grossProfitMru        Decimal            @map("gross_profit_mru") @db.Decimal(24, 4)
  recipientName         String?            @map("recipient_name")
  destination           String?
  reversalReason        String?            @map("reversal_reason")
  reversedByUserId      String?            @map("reversed_by_user_id") @db.Uuid
  reversedAt            DateTime?          @map("reversed_at") @db.Timestamptz(6)

  contact           Contact?       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  deliveredCurrency Currency       @relation("sale_delivered_currency", fields: [deliveredCurrencyId], references: [id], onDelete: Restrict)
  paymentCurrency   Currency       @relation("sale_payment_currency", fields: [paymentCurrencyId], references: [id], onDelete: Restrict)
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  createdBy         User           @relation("sale_created_by", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedBy        User?          @relation("sale_reversed_by", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@index([transactionDate(sort: Desc), status], map: "sale_transaction_status_idx")
  @@index([contactId, transactionDate(sort: Desc)], map: "sale_contact_transaction_idx")
  @@map("sale")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  reason      String?
  ip          String?  @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("audit_actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_log_entity_created_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_log_actor_created_idx")
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// P5-01 · payments, allocations, expenses (D-011, D-017, D-020)
// ---------------------------------------------------------------------------
//
// payment carries a single direction enum rather than separate received/paid
// tables — the liveness rule (D-011) applies identically to both directions.
// allocation.target_id is polymorphic (no FK); liveness is derived by joining
// to the correct debt table based on target_type at query time.
// expense has no contact — expenses reduce net profit, not a receivable/payable.

enum PaymentDirection {
  RECEIVED_FROM_CUSTOMER
  PAID_TO_SUPPLIER

  @@map("payment_direction")
}

enum PaymentStatus {
  CONFIRMED
  REVERSED

  @@map("payment_status")
}

enum ExpenseStatus {
  CONFIRMED
  REVERSED

  @@map("expense_status")
}

model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  contactId         String           @map("contact_id") @db.Uuid
  currencyId        String           @map("currency_id") @db.Uuid
  amount            Decimal          @db.Decimal(24, 4)
  direction         PaymentDirection
  paymentMethodId   String           @map("payment_method_id") @db.Uuid
  paymentMethodNote String?          @map("payment_method_note")
  status            PaymentStatus    @default(CONFIRMED)
  reference         String?
  notes             String?
  transactionDate   DateTime         @map("transaction_date") @db.Timestamptz(6)
  createdByUserId   String           @map("created_by_user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  reversalReason    String?          @map("reversal_reason")
  reversedByUserId  String?          @map("reversed_by_user_id") @db.Uuid
  reversedAt        DateTime?        @map("reversed_at") @db.Timestamptz(6)

  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  currency      Currency      @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("payment_created_by", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedBy    User?         @relation("payment_reversed_by", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  allocations   Allocation[]

  @@index([contactId, transactionDate(sort: Desc)], map: "payment_contact_transaction_date_idx")
  @@map("payment")
}

model Allocation {
  id         String   @id @default(uuid()) @db.Uuid
  paymentId  String   @map("payment_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  amount     Decimal  @db.Decimal(24, 4)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId], map: "allocation_target_idx")
  @@index([paymentId], map: "allocation_payment_idx")
  @@map("allocation")
}

model Expense {
  id                String        @id @default(uuid()) @db.Uuid
  expenseCategoryId String        @map("expense_category_id") @db.Uuid
  currencyId        String        @map("currency_id") @db.Uuid
  amount            Decimal       @db.Decimal(24, 4)
  paymentMethodId   String        @map("payment_method_id") @db.Uuid
  paymentMethodNote String?       @map("payment_method_note")
  description       String
  status            ExpenseStatus @default(CONFIRMED)
  transactionDate   DateTime      @map("transaction_date") @db.Timestamptz(6)
  createdByUserId   String        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  reversalReason    String?       @map("reversal_reason")
  reversedByUserId  String?       @map("reversed_by_user_id") @db.Uuid
  reversedAt        DateTime?     @map("reversed_at") @db.Timestamptz(6)

  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)
  currency        Currency        @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  paymentMethod   PaymentMethod   @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  createdBy       User            @relation("expense_created_by", fields: [createdByUserId], references: [id], onDelete: Restrict)
  reversedBy      User?           @relation("expense_reversed_by", fields: [reversedByUserId], references: [id], onDelete: SetNull)

  @@index([transactionDate(sort: Desc), expenseCategoryId], map: "expense_transaction_category_idx")
  @@map("expense")
}

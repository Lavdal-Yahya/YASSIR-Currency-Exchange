// Prisma schema. Models added phase by phase per docs/phases/phase-N.md.
// P1-04 introduces the auth surface (User, Role, Permission, plus the join
// tables and audit_log). No financial tables land until P3-01.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// P1-04 · auth
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid()) @db.Uuid
  phone             String    @unique
  pinHash           String    @map("pin_hash")
  fullName          String    @map("full_name")
  isActive          Boolean   @default(true) @map("is_active")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles     UserRole[]
  auditRows AuditLog[] @relation("audit_actor")

  @@map("user")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  labelFr  String  @map("label_fr")
  labelAr  String  @map("label_ar")

  users       UserRole[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// P2-01 · currencies (master data)
// ---------------------------------------------------------------------------
//
// `code` is the ISO-4217-ish identifier we display everywhere ("MRU", "USD").
// It is *not* immutable in the schema — the immutability check is enforced
// in the service by counting rows in the ledger (P3+). Making it immutable
// at the DB level would fight the initial seed & typo-correction window.
//
// `decimalPlaces` drives every rounding decision (D-009). USD=2, JPY=0,
// high-precision internal book-keeping currencies can go up to 6.
// `lowBalanceThreshold` is per-currency (spec §22.3 dashboard warning);
// nullable = no warning configured.
//
// No `is_base` column — the base currency is a single FK on the settings
// row (added in P2-02). Duplicating it here would risk two rows disagreeing.
//
// Deletion is refused at the application role level via a REVOKE in the
// migration. See phase-2.md §3.

model Currency {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique
  name                  String
  symbol                String?
  decimalPlaces         Int      @map("decimal_places") @db.SmallInt
  lowBalanceThreshold   Decimal? @map("low_balance_threshold") @db.Decimal(24, 4)
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  baseForSettings Settings[] @relation("settings_base_currency")

  @@map("currency")
}

// ---------------------------------------------------------------------------
// P2-02 · settings (single-row)
// ---------------------------------------------------------------------------
//
// The one row. `id = 1` is enforced by a CHECK in the migration so a
// second row cannot exist. `baseCurrencyId` FKs to Currency; the seed
// pins it to MRU. `businessTimezone` is what common/period.ts reads at
// runtime — the env var stays as a test-boot fallback (D-012).
//
// `goLiveAt` is set exactly once and never cleared (checked in the
// service). Before it is set, opening balances are editable (P3-10);
// after, only owner-authorized adjustments.
//
// `negativeBalanceOverrideAllowed` is the tri-state toggle for D-015 —
// even when true, non-base currencies still refuse a negative balance
// at the DB level (P3 constraint). MRU can be overdrawn only by owners
// with a reason.

model Settings {
  id                              Int      @id @default(1)
  baseCurrencyId                  String   @map("base_currency_id") @db.Uuid
  businessTimezone                String   @default("Africa/Nouakchott") @map("business_timezone")
  negativeBalanceOverrideAllowed  Boolean  @default(false) @map("negative_balance_override_allowed")
  goLiveAt                        DateTime? @map("go_live_at") @db.Timestamptz(6)
  updatedAt                       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId                 String?  @map("updated_by_user_id") @db.Uuid

  baseCurrency Currency @relation("settings_base_currency", fields: [baseCurrencyId], references: [id], onDelete: Restrict)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// P2-03 · contact (customers + suppliers, one row per person)
// ---------------------------------------------------------------------------
//
// A single row for a person who transacts with the bureau. `isCustomer` and
// `isSupplier` are independent booleans — the same person can be both, and
// the CHECK constraint refuses a row that is neither (spec §10.2, phase-2.md
// §3). Flipping either flag preserves the row's ID and notes.
//
// `phone` is nullable — walk-in customers may not want to give one, and the
// duplicate-phone rule is a **warning, not a block** (spec §10.3). The
// service returns 409 with `warning: duplicate_phone` on POST; a second POST
// with `confirmDuplicate: true` proceeds. Enforcing uniqueness at the DB
// would remove the operator's ability to say "yes it's a different person
// with the same number".
//
// `isArchived` replaces delete. Once a contact appears on a trade or debt
// their row must remain readable for historical statements.

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  phone       String?
  isCustomer  Boolean  @default(true) @map("is_customer")
  isSupplier  Boolean  @default(false) @map("is_supplier")
  isArchived  Boolean  @default(false) @map("is_archived")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([phone], map: "contact_phone_idx")
  @@map("contact")
}

// ---------------------------------------------------------------------------
// P2-04 · expense_category (lookup)
// ---------------------------------------------------------------------------
//
// Categorises expense rows (P5). Kept as an editable table — the client
// tunes the taxonomy over time. Referenced by `expense.category_id` from
// P5-01; deactivation is preferred over delete for the same historical
// reason as currency / payment_method / contact.

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("expense_category")
}

// ---------------------------------------------------------------------------
// P2-05 · payment_method lookup (D-020)
// ---------------------------------------------------------------------------
//
// Not an enum — Mauritanian mobile-money providers change. A new one
// should be a row the owner adds in Settings, not a migration + deploy.
// Seeded with CASH / BANKILY / MASRIVI / SEDAD / OTHER; only OTHER has
// requires_note = true. `code` is unique and never edited after create
// — renaming a method would rewrite how last year's cash arrived
// (architecture §3.6).
//
// Referenced by the `payment_method_id` column on ledger entries from
// P3-02 (D-020). The relation itself is added when the ledger table
// exists.

model PaymentMethod {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  labelFr       String   @map("label_fr")
  labelAr       String   @map("label_ar")
  isActive      Boolean  @default(true) @map("is_active")
  requiresNote  Boolean  @default(false) @map("requires_note")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_method")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  entityType   String?  @map("entity_type")
  entityId     String?  @map("entity_id")
  before       Json?
  after        Json?
  reason       String?
  ip           String?  @db.Inet
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("audit_actor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_log_entity_created_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_log_actor_created_idx")
  @@map("audit_log")
}

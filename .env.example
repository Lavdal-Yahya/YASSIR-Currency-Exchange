# Copy to `.env` and adjust. `.env` is gitignored.
# Every var here is validated at boot by api/src/config/env.schema.ts —
# a missing or malformed value crashes the api, it does not fall back.

# --- Postgres (also read by docker-compose.yml) --------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=currency_exchange
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# Prisma reads DATABASE_URL directly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/currency_exchange

# JWT secret — 32+ bytes of entropy. Rotate on a breach; do not reuse across
# environments. Generate with: `openssl rand -base64 48`
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
# Sliding session ceiling, per phase-1 §3 (AuthService). Format: number + s/m/h/d.
JWT_TTL=12h
# Cookie name and SameSite policy (Lax per architecture.md §4).
COOKIE_NAME=cx_session

# Business timezone. Reads from settings row from P2 onwards (D-012); this
# env var is the fallback used in P1 and in tests that boot without the row.
BUSINESS_TZ=Africa/Nouakchott

# --- Web ------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1

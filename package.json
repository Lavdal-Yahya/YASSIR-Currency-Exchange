{
  "name": "currency-exchange",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Currency exchange bureau management system — monorepo root",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace api run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm-run-all build:api build:web",
    "build:api": "npm --workspace api run build",
    "build:web": "npm --workspace web run build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "npm-run-all --parallel typecheck:api typecheck:web",
    "typecheck:api": "npm --workspace api run typecheck",
    "typecheck:web": "npm --workspace web run typecheck",
    "test": "npm-run-all --parallel test:api test:web",
    "test:api": "npm --workspace api run test",
    "test:web": "npm --workspace web run test",
    "ci": "npm-run-all lint typecheck test"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
